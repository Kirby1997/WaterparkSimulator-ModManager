<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\GamePaths.props" />

  <PropertyGroup>
    <!-- BepInEx IL2CPP hosts plugins on its bundled .NET 6 runtime. -->
    <TargetFramework>net6.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Off: the interop assemblies expose their own NullableAttribute, which breaks the compiler's. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModManager.Core\ModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(BepInExCoreDir)\BepInEx.Core.dll" Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP" HintPath="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCoreDir)\0Harmony.dll" Private="false" />
    <Reference Include="Il2CppInterop.Runtime" HintPath="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="SemanticVersioning" HintPath="$(BepInExCoreDir)\SemanticVersioning.dll" Private="false" />
    <!-- The game's own types, as proxy assemblies generated by BepInEx. -->
    <Reference Include="$(InteropDir)\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameFiles" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.Core.dll')"
           Text="BepInEx not found in '$(BepInExDir)'. Install BepInExPack_IL2CPP with r2modman, or set ProfileDir in GamePaths.user.props." />
    <Error Condition="!Exists('$(InteropDir)\Assembly-CSharp.dll')"
           Text="Game interop assemblies not found in '$(InteropDir)'. Start the game once with BepInEx installed so it generates them." />
  </Target>

  <Target Name="DeployPlugin" AfterTargets="Build">
    <ItemGroup>
      <DeployFiles Include="$(TargetDir)ModManager.*.dll" />
      <!-- When the mod is installed through r2modman it lives in <Team>-ModManager; build over that copy. -->
      <ManagedCopy Include="$(BepInExDir)\plugins\*-ModManager\ModManager.Plugin.dll" />
    </ItemGroup>
    <PropertyGroup Condition="'@(ManagedCopy)' != ''">
      <PluginDeployDir>%(ManagedCopy.RootDir)%(ManagedCopy.Directory)</PluginDeployDir>
    </PropertyGroup>
    <!-- A copy built before the mod was installed through r2modman would load as a duplicate. -->
    <RemoveDir Directories="$(BepInExDir)\plugins\ModManager" Condition="'@(ManagedCopy)' != ''" />
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(PluginDeployDir)" />
    <Message Importance="high" Text="Deployed @(DeployFiles->'%(Filename)%(Extension)', ', ') to $(PluginDeployDir)" />
  </Target>

</Project>
